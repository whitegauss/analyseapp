# Go API
API_PORT=8080
REDIS_ADDR=redis:6379
WORKER_BASE_URL=http://worker:8001

# Python Worker
WORKER_PORT=8001

# Frontend (Next.js)
FRONTEND_PORT=3000

# Supabase - Frontend (Next.js側、Supabase Authでのログインにのみ使用。ブラウザに公開される値)
# 取得元: Supabase Dashboard > Project Settings > API > Project URL / Project API keys(anon public)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase - Go API側（Supabaseへの唯一の接続口。テーブルデータへは直接Postgres接続でアクセスする）
# 取得元: Supabase Dashboard > Project Settings > Database > Connection string (URI、常時稼働バックエンドならSession pooler推奨)
DATABASE_URL=
# 取得元: Supabase Dashboard > Project Settings > API > Project URL（NEXT_PUBLIC_SUPABASE_URLと同じ値）
# ブラウザ側のSupabase Auth JWTをGo APIがJWKS（${SUPABASE_URL}/auth/v1/.well-known/jwks.json）経由で検証するために使用
SUPABASE_URL=
